---
import type { InternalFileType } from "../../../constants/file-type";
import { BottomCtaSection as BottomCtaSectionComponent } from "./BottomCtaSection";

interface Props {
  readonly title: string;
  readonly subtitle: string;
  readonly buttonLabel: string;
  readonly acceptedFormats: InternalFileType[];
  readonly className?: string;
}

const { title, subtitle, buttonLabel, acceptedFormats, className } =
  Astro.props;
---

<BottomCtaSectionComponent
  client:load
  title={title}
  subtitle={subtitle}
  buttonLabel={buttonLabel}
  acceptedFormats={acceptedFormats}
  className={className}
/>
