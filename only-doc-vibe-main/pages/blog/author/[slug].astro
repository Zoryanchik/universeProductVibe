---
import type { ELanguages } from "@/shared/constants/languages";

import { BlogAuthorPage } from "@/pages-layer/blog";
import { getBlogAuthorStaticPaths } from "@/pages-layer/blog";

export const getStaticPaths = getBlogAuthorStaticPaths;

interface Props {
  locale: ELanguages;
  slug: string;
  localeSlugMap: Record<string, string>;
}

const { locale, slug, localeSlugMap } = Astro.props;
---

<BlogAuthorPage locale={locale} slug={slug} localeSlugMap={localeSlugMap} />
