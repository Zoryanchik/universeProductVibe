---
import emailIcon from "@public/assets/contact-us/email-icon.svg?url";
import addressIcon from "@public/assets/contact-us/address-icon.svg?url";
import phoneIcon from "@public/assets/contact-us/phone-icon.svg?url";

import { Image } from "@/shared/ui/image";
import { Title } from "@/shared/ui/title";
import { createServerT } from "@/shared/lib/translations/server-t";
import { PageViewTracker } from "@/shared/ui/page-view-tracker";

import { ContactUsForm } from "@/features/contact-us";

import BasePage from "../../base/ui/BasePage.astro";
import { fetchContactUsPageData } from "../api/fetch-contact-us-page-data";
import { resolveContactUsContent } from "../api/resolve-contact-us-content";

import { SeoBaseLayout } from "@/app/layout/seoLayout";

const { lang, localeSlugMap } = Astro.props;

const { pageData, navbarData, footerData } = await fetchContactUsPageData(lang);
const translate = createServerT(lang);

const { title, subtitle, seoProps, email, address, phone, formContent } =
  resolveContactUsContent({
    pageData,
    translate,
    fallbackIcons: { email: emailIcon, address: addressIcon, phone: phoneIcon },
    pathname: Astro.url.pathname,
    url: Astro.url.href,
    lang,
    localeSlugMap,
  });

const contactItems = [
  { ...email, href: `mailto:${email.value}`, alt: "Email icon" },
  { ...phone, href: `tel:${phone.value}`, alt: "Phone icon" },
  { ...address, href: undefined, alt: "Address icon" },
];
---

<SeoBaseLayout {...seoProps} lang={lang}>
  <BasePage lang={lang} navbarData={navbarData} footerData={footerData}>
    <PageViewTracker eventName="contact_us_page_view" client:load />
    <section
      class="relative flex w-full flex-col items-center overflow-hidden bg-[var(--color-bg-light-grey)] px-4 py-6 md:px-8 md:pt-20 md:pb-[150px]"
    >
      <div
        class="flex w-full max-w-[1140px] flex-col items-center gap-4 md:gap-10"
      >
        <!-- Title & Subtitle -->
        <div class="flex w-full flex-col items-center gap-2 text-center">
          <Title
            level="h1"
            variant="desktop-title-1"
            className="text-text-primary text-mobile-title-1 md:text-desktop-title-1"
          >
            {title}
          </Title>
          <p class="text-body-2 md:text-bod max-w-[600px]">
            {subtitle}
          </p>
        </div>

        <!-- Content: Contact Info + Form -->
        <div
          class="flex w-full flex-col items-start gap-4 md:flex-row md:items-stretch md:gap-6"
        >
          <!-- Left: Contact Info Cards -->
          <div class="flex w-full flex-1 flex-col gap-2 md:self-stretch">
            {
              contactItems.map((item) => {
                const Wrapper = item.href ? "a" : "div";

                return (
                  <Wrapper
                    href={item.href}
                    class="flex items-center gap-4 rounded-2xl bg-white p-6 md:flex-1 md:gap-6"
                  >
                    <Image
                      src={item.iconSrc}
                      alt={item.alt}
                      className="size-10 shrink-0 md:size-[58px]"
                    />
                    <div class="flex flex-col gap-1">
                      <span class="text-text-primary text-[20px] leading-6 font-semibold">
                        {item.label}
                      </span>
                      <span class="text-body text-text-primary whitespace-pre-line">
                        {item.value}
                      </span>
                    </div>
                  </Wrapper>
                );
              })
            }
          </div>

          <!-- Right: Contact Form -->
          <ContactUsForm client:load content={formContent} />
        </div>
      </div>
    </section>
  </BasePage>
</SeoBaseLayout>
