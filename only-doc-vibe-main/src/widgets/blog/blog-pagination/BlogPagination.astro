---
import { cn } from "@/shared/lib/utils/cn";

interface Props {
  page: number;
  pageCount: number;
  /**
   * Base path for paginated routes (without trailing slash). Page 1 uses
   * `basePath`; pages 2+ use `${basePath}/page/N`.
   */
  basePath: string;
  className?: string;
}

const { page, pageCount, basePath, className } = Astro.props;

const buildHref = (target: number): string =>
  target <= 1 ? basePath : `${basePath}/page/${target}`;

const buildPagesList = (current: number, total: number): (number | "…")[] => {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);

  const items: (number | "…")[] = [1];
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);

  if (start > 2) items.push("…");

  for (let i = start; i <= end; i++) items.push(i);
  if (end < total - 1) items.push("…");

  items.push(total);

  return items;
};

const pages = buildPagesList(page, pageCount);
const prevPage = page > 1 ? page - 1 : null;
const nextPage = page < pageCount ? page + 1 : null;
const isFirst = page === 1;
const isLast = page === pageCount;

const navBtnBase =
  "inline-flex h-8 w-8 items-center justify-center rounded-[8px] transition-colors";
const navBtnActive =
  "text-[var(--color-action-active)] hover:bg-[var(--color-action-8)]";
const navBtnDisabled = "pointer-events-none text-[rgba(0,0,0,0.26)] opacity-60";
const chevronPath =
  "M10.8 12L14.7 15.9C14.8833 16.0833 14.975 16.3167 14.975 16.6C14.975 16.8833 14.8833 17.1167 14.7 17.3C14.5167 17.4833 14.2833 17.575 14 17.575C13.7167 17.575 13.4833 17.4833 13.3 17.3L8.7 12.7C8.6 12.6 8.525 12.4917 8.475 12.375C8.44167 12.2583 8.425 12.1333 8.425 12C8.425 11.8667 8.44167 11.7417 8.475 11.625C8.525 11.5083 8.6 11.4 8.7 11.3L13.3 6.7C13.4833 6.51667 13.7167 6.425 14 6.425C14.2833 6.425 14.5167 6.51667 14.7 6.7C14.8833 6.88333 14.975 7.11667 14.975 7.4C14.975 7.68333 14.8833 7.91667 14.7 8.1L10.8 12Z";
---

{
  pageCount > 1 && (
    <nav
      aria-label="Blog pagination"
      class={cn("flex items-center justify-center gap-2 p-2", className)}
    >
      {/* First page — a real link when reachable, otherwise a non-interactive,
          AT-hidden span (aria-disabled on <a> is a prohibited ARIA usage). */}
      {isFirst ? (
        <span aria-hidden="true" class={cn(navBtnBase, navBtnDisabled)}>
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none">
            <path d={chevronPath} fill="currentColor" />
            <path
              d={chevronPath}
              fill="currentColor"
              transform="translate(-4 0)"
            />
          </svg>
        </span>
      ) : (
        <a
          href={buildHref(1)}
          aria-label="First page"
          class={cn(navBtnBase, navBtnActive)}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-5 w-5"
            fill="none"
          >
            <path d={chevronPath} fill="currentColor" />
            <path
              d={chevronPath}
              fill="currentColor"
              transform="translate(-4 0)"
            />
          </svg>
        </a>
      )}

      {/* Prev arrow */}
      {prevPage ? (
        <a
          href={buildHref(prevPage)}
          aria-label="Previous page"
          class={cn(navBtnBase, navBtnActive)}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-5 w-5"
            fill="none"
          >
            <path d={chevronPath} fill="currentColor" />
          </svg>
        </a>
      ) : (
        <span aria-hidden="true" class={cn(navBtnBase, navBtnDisabled)}>
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none">
            <path d={chevronPath} fill="currentColor" />
          </svg>
        </span>
      )}

      {/* Page numbers */}
      <ul class="flex items-center gap-1">
        {pages.map((entry) => (
          <li>
            {entry === "…" ? (
              <span
                aria-hidden="true"
                class="inline-flex h-8 min-w-8 items-center justify-center px-1 text-[14px] text-[rgba(0,0,0,0.87)]"
              >
                …
              </span>
            ) : (
              <a
                href={buildHref(entry)}
                aria-current={entry === page ? "page" : undefined}
                class={cn(
                  "inline-flex h-8 min-w-8 items-center justify-center rounded-[8px] px-2 text-[14px] leading-[20px] font-medium transition-colors",
                  entry === page
                    ? "bg-[var(--color-action-8)] text-[var(--color-text-primary)]"
                    : "text-[var(--color-text-primary)] hover:bg-[var(--color-action-8)]"
                )}
              >
                {entry}
              </a>
            )}
          </li>
        ))}
      </ul>

      {/* Next arrow */}
      {nextPage ? (
        <a
          href={buildHref(nextPage)}
          aria-label="Next page"
          class={cn(navBtnBase, navBtnActive)}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-5 w-5 rotate-180"
            fill="none"
          >
            <path d={chevronPath} fill="currentColor" />
          </svg>
        </a>
      ) : (
        <span aria-hidden="true" class={cn(navBtnBase, navBtnDisabled)}>
          <svg viewBox="0 0 24 24" class="h-5 w-5 rotate-180" fill="none">
            <path d={chevronPath} fill="currentColor" />
          </svg>
        </span>
      )}

      {/* Last page */}
      {isLast ? (
        <span aria-hidden="true" class={cn(navBtnBase, navBtnDisabled)}>
          <svg viewBox="0 0 24 24" class="h-5 w-5 rotate-180" fill="none">
            <path d={chevronPath} fill="currentColor" />
            <path
              d={chevronPath}
              fill="currentColor"
              transform="translate(-4 0)"
            />
          </svg>
        </span>
      ) : (
        <a
          href={buildHref(pageCount)}
          aria-label="Last page"
          class={cn(navBtnBase, navBtnActive)}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-5 w-5 rotate-180"
            fill="none"
          >
            <path d={chevronPath} fill="currentColor" />
            <path
              d={chevronPath}
              fill="currentColor"
              transform="translate(-4 0)"
            />
          </svg>
        </a>
      )}
    </nav>
  )
}
