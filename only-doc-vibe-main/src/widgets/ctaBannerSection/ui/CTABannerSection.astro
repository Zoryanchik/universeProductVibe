---
import { Title } from "@/shared/ui/title";

import type { ICTABannerSectionProps } from "../model/types";
import { CTAUploadButtonWithFunnel } from "./CTAUploadButtonWithFunnel";

type Props = ICTABannerSectionProps;

const {
  title,
  badges,
  buttonLabel,
  serviceType,
  funnel,
  formatTo,
  acceptedFormats,
} = Astro.props;
---

<section class="bg-white">
  <div
    class="mx-auto w-full max-w-[1440px] px-4 pt-10 pb-[104px] md:px-[150px]"
  >
    <div
      class="relative flex min-h-[388px] flex-col items-center justify-center gap-12 overflow-hidden rounded-[20px] bg-black px-6 py-12 [--color-primary-dark:#E8CA3A] md:px-16 md:py-16"
    >
      <div
        class="pointer-events-none absolute inset-x-5 inset-y-6 rounded-2xl border-2 border-dashed border-[var(--color-material-grey-500)]"
      >
      </div>

      <div class="relative z-10 flex flex-col items-center gap-6">
        <Title variant="desktop-title-2" className="text-white">{title}</Title>

        <div class="flex flex-wrap justify-center gap-2">
          {
            badges.map((badge) => (
              <span class="text-body-2 flex items-center gap-1 rounded-2xl bg-white/20 px-2.5 py-1.5 text-white">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  class="shrink-0"
                >
                  <path
                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"
                    fill="currentColor"
                  />
                </svg>
                {badge.label}
              </span>
            ))
          }
        </div>
      </div>

      <CTAUploadButtonWithFunnel
        client:load
        label={buttonLabel}
        serviceType={serviceType}
        funnel={funnel}
        formatTo={formatTo}
        acceptedFormats={acceptedFormats}
        showGlow={false}
        className="relative z-10"
      />
    </div>
  </div>
</section>
