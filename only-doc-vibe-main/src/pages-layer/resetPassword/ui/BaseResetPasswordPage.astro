---
import { cn } from "@universe-forma/ui-pes";

import type { ELanguages } from "@/shared/constants/languages";
import { PAGE_LINKS } from "@/shared/constants/page-links";
import { navigateThroughURL } from "@/shared/lib/seo/navigate-through-url";
import { createServerT } from "@/shared/lib/translations/server-t";

import { ResetPasswordForm } from "@/features/auth-reset-password";

import { HeaderLogoOnly } from "@/widgets/headerLogoOnly";

import { SeoBaseLayout } from "@/app/layout/seoLayout";

interface Props {
  lang: ELanguages;
}

const { lang: currentLocale } = Astro.props;

const t = createServerT(currentLocale);

const loginHref = navigateThroughURL(PAGE_LINKS.LOGIN, currentLocale);

const copyright = String(
  t("footer.copyright", { date: new Date().getFullYear() })
);
---

<SeoBaseLayout
  lang={currentLocale}
  title={String(t("reset_password.seo_title"))}
  description={String(t("reset_password.seo_description"))}
  isHidden
>
  <div class="bg-material-grey-100 flex min-h-dvh flex-col overflow-y-auto">
    <HeaderLogoOnly />
    <div class={cn("flex flex-1 justify-center items-center", "max-sm:px-4")}>
      <ResetPasswordForm client:load loginHref={loginHref} />
    </div>
    <footer class="flex items-end justify-center self-stretch pt-8 pb-6">
      <p class="text-body text-text-disabled">
        {copyright}
      </p>
    </footer>
  </div>
</SeoBaseLayout>
