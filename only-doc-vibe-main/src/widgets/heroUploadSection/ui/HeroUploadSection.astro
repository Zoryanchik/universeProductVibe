---
import type { IHeroUploadSectionProps } from "../model/types";
import { DefaultHeroWithFunnel } from "./DefaultHeroWithFunnel";

type Props = IHeroUploadSectionProps;

const {
  title,
  subtitle,
  uploadButtonLabel,
  dropText,
  supportedFormatsText,
  maxSizeText,
  serviceType,
  funnel,
  formatTo,
  acceptedFormats,
} = Astro.props;
---

<section class="bg-[var(--color-bg-light-grey)]">
  <div class="mx-auto w-full max-w-[1440px] px-4 py-6 md:px-10 md:py-10">
    <DefaultHeroWithFunnel
      client:load
      title={title}
      subtitle={subtitle}
      buttonLabel={uploadButtonLabel}
      dropText={dropText}
      supportedFormatsText={supportedFormatsText}
      maxSizeText={maxSizeText}
      serviceType={serviceType}
      funnel={funnel}
      formatTo={formatTo}
      acceptedFormats={acceptedFormats}
    />

    <slot />
  </div>
</section>
