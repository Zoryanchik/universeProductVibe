# SERVER ONLY ENVs

# CMS domain without "https://" (used to build requests)
CMS_HOST=""

# Token for read-only operations from CMS 
# (e.g. fetching data/content for the website)
CMS_READ_TOKEN=""

# SHARED BETWEEN SERVER AND CLIENT ENVS

# Environment in which you will run scripts one of: "local", "development", "test", "staging", "production"
ENVIRONMENT=development

# Origin of the website without "https://"
WEB_HOST=ltdcfqn.only-doc.com

# Origin of the backend without "https://"
BACKEND_HOST=api-dev.only-doc.com

# Base path for the project. 
# It should be empty if you are using root domain, otherwise in must start with slash and without ending slash
# e.g. "/new" 
PROJECT_BASE=""

# main app base url (base url of the main app with editor page, dashboard, etc)
MAIN_APP_BASE="https://tobedefined.com"

# Google Analytics id
GTAG_ID=G-tobedefined

CAPTCHA_LIMIT=10

# Microsoft clarity id
MICROSOFT_CLARITY_ID=your_clarity_project_id

# Key for amplitude
AMPLITUDE_KEY=tobedefined

# Google auth client id for oauth
GOOGLE_AUTH_CLIENT_ID="123"

# Customer io key
CUSTOMER_IO_KEY="123"

# SW base is relative path from origin to service worker file, usually it must be root
SW_BASE=""

# --- AI Summarizer ---

# Notifications service SSE subscribe endpoint (full URL).
# Local dev usually points to the pdf-fly notifications service:
#   http://localhost:3005/notifications/subscribe
REACT_APP_SSE_URL="http://localhost:3005/notifications/subscribe"

# Optional SSE tuning — defaults match production behaviour.
REACT_APP_SSE_MAX_RECONNECTION_ATTEMPTS=30
REACT_APP_SSE_RECONNECTION_DELAY=30000

# AI Summarizer feature limits (BE enforces these too; FE pre-checks for UX).
AI_SUMMARIZER_MAX_FILE_SIZE_MB=25
AI_SUMMARIZER_MAX_MESSAGE_CHARS=2000
AI_SUMMARIZER_MAX_PAGES=200

# --- Templates Editor (Polotno) ---

# Polotno editor API key (https://polotno.com). Public client key.
PUBLIC_POLOTNO_API_KEY=""
