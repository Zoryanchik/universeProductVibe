---
import type { ELanguages } from "@/shared/constants/languages";

import { getLocalizedResetPasswordPages } from "../api/get-reset-password-static-routes";
import BaseResetPasswordPage from "./BaseResetPasswordPage.astro";

interface IParams {
  lang: ELanguages;
}

export async function getResetPasswordLocalesStaticPaths() {
  return await getLocalizedResetPasswordPages();
}

const { lang } = Astro.params as unknown as IParams;
---

<BaseResetPasswordPage lang={lang} />
