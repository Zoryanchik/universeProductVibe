{
  "name": "only-doc",
  "type": "module",
  "version": "0.0.22",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "start": "npm run generate-api-schema && astro dev",
    "prebuild": "cp src/styles/vars.css public/vars.css",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "i18n:prune": "node scripts/prune-ppc-locales.js --dry",
    "i18n:prune:write": "node scripts/prune-ppc-locales.js --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:formatter": "prettier --check .",
    "format": "eslint . --fix && prettier --write . --log-level warn",
    "lint:types": "astro check --root ./",
    "precommit": "concurrently \"npm run lint:fix\" \"npm run lint:types\" \"npm run format\"",
    "lint-workflow": "concurrently \"npm run lint\" \"npm run lint:types\"",
    "generate-api-schema": "node scripts/extract-openapi-spec.mjs && openapi-typescript ./openapi-spec.json -o ./src/shared/api/cms/cms-schema.ts && node scripts/fix-cms-schema.js && node -e \"try{require('fs').unlinkSync('openapi-spec.json')}catch(e){}\"",
    "prepare": "husky",
    "vibe:prepare": "node scripts/prepare-vibe-template.mjs",
    "vibe:refresh": "node scripts/refresh-vendor.mjs",
    "vibe:up": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.23.5",
    "@astrojs/check": "^0.9.5",
    "@astrojs/react": "^4.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lottiefiles/dotlottie-react": "^0.15.1",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@types/react-signature-canvas": "^1.0.7",
    "@universe-forma/global-types": "file:./vendor/universe-forma-global-types-2.4.0.tgz",
    "@universe-forma/ui-pes": "file:./vendor/universe-forma-ui-pes-0.4.36.tgz",
    "antd": "^5.27.1",
    "astro": "^5.15.4",
    "axios": "^1.11.0",
    "beautify-qrcode": "^1.0.3",
    "eyedropper-polyfill": "^1.1.5",
    "framer-motion": "^12.10.4",
    "franc": "^6.2.0",
    "heic-to": "^1.3.0",
    "js-cookie": "^3.0.5",
    "jsbarcode": "^3.11.6",
    "jspdf": "^3.0.1",
    "jszip": "^3.10.1",
    "markdown-to-jsx": "^7.7.13",
    "material-symbols": "^0.45.3",
    "mobx": "^6.16.1",
    "openapi-typescript": "^6.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.54",
    "polotno": "^4.1.3",
    "query-string": "^9.4.0",
    "react": "^19.1.0",
    "react-compare-slider": "^3.1.0",
    "react-microsoft-clarity": "^2.0.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "typescript": "^5.9.2",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.4",
    "@eslint/js": "^9.33.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/eslint-plugin-jsx-a11y": "^6.10.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.24",
    "@types/serviceworker": "^0.0.153",
    "astro-compressor": "^1.0.0",
    "astro-eslint-parser": "^1.2.2",
    "concurrently": "^9.2.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.23.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-next-fsd": "^0.0.7",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.5.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.11",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.4.1",
    "vite-plugin-static-copy": "^3.4.0",
    "vite-plugin-svgr": "^4.5.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.9.5",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.16",
    "lightningcss-linux-x64-gnu": "^1.30.2"
  }
}
