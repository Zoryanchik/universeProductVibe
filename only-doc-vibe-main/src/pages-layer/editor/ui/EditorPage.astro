---
import type { ELanguages } from "@/shared/constants/languages";
import { defaultLocale } from "@/shared/config/locale";
import { createServerT } from "@/shared/lib/translations/server-t";

import { EditorShell } from "./EditorShell";

import { SeoBaseLayout } from "@/app/layout/seoLayout";

interface Props {
  lang?: ELanguages;
}

const { lang = defaultLocale } = Astro.props;
const t = createServerT(lang);
---

<SeoBaseLayout
  lang={lang}
  title={String(t("editor_page.seo_title"))}
  description={String(t("editor_page.seo_description"))}
  isHidden
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/element-plus/dist/index.css"
  />
  <script
    slot="head"
    is:inline
    src="https://cdn.jsdelivr.net/npm/vue@3.4.30/dist/vue.global.prod.js"
  ></script>
  <script
    slot="head"
    is:inline
    src="https://cdn.jsdelivr.net/npm/vue-demi@0.14.6/lib/index.iife.min.js"
  ></script>
  <script
    slot="head"
    is:inline
    src="https://cdn.jsdelivr.net/npm/pinia@2.1.7/dist/pinia.iife.prod.js"
  ></script>
  <script
    slot="head"
    is:inline
    src="https://cdn.jsdelivr.net/npm/element-plus/dist/index.full.min.js"
  ></script>
  <script
    slot="head"
    is:inline
    src="/pdf-editor-sdk/pdf-editor-sdk.umd.js?v=continuous20"></script>

  <EditorShell client:only="react" locale={lang} />
</SeoBaseLayout>

<style is:global>
  /* Scope editor layout to the SDK container only */
  .pdf-editor-scope {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .pdf-editor-scope .pdf-editor-wrapper,
  .pdf-editor-scope .canvas-container {
    background-color: #2a2d33;
  }
</style>
