---
import { MICROSOFT_CLARITY_ID } from "astro:env/client";

const clarityId = MICROSOFT_CLARITY_ID;
---

<script is:inline define:vars={{ clarityId }}>
  // Defer Clarity until first interaction/idle so its tag doesn't compete with
  // initial render/hydration for main-thread time.
  (
    window.__deferThirdParty ||
    function (cb) {
      cb();
    }
  )(function () {
    (function (c, l, a, r, i, t, y) {
      c[a] =
        c[a] ||
        function () {
          (c[a].q = c[a].q || []).push(arguments);
        };
      t = l.createElement(r);
      t.async = 1;
      t.src = "https://www.clarity.ms/tag/" + i;
      y = l.getElementsByTagName(r)[0];
      y.parentNode.insertBefore(t, y);
    })(window, document, "clarity", "script", clarityId);
  });
</script>
