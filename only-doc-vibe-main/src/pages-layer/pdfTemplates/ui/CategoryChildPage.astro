---
import CategoryListPage from "./CategoryListPage.astro";
import TemplatePage from "./TemplatePage.astro";

type Props =
  | { kind: "subcategory"; categorySlug: string; subcategorySlug: string }
  | { kind: "template"; categorySlug: string; templateSlug: string };

const props = Astro.props as Props;
---

{
  props.kind === "template" ? (
    <TemplatePage
      categorySlug={props.categorySlug}
      templateSlug={props.templateSlug}
    />
  ) : (
    <CategoryListPage
      categorySlug={props.categorySlug}
      subcategorySlug={props.subcategorySlug}
    />
  )
}
